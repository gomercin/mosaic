{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2A.1.0"
    },
    "sourceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "publicationApproval": {
      "type": "object",
      "properties": {
        "status": {
          "const": "pending"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "storageMergeReport": {},
    "editorialReview": {
      "anyOf": [
        {
          "const": null
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://gomercin.github.io/mosaic/schemas/editorial-review.v2a.schema.json",
          "title": "Private proposed editorial review for Phase 2A",
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "2A.1.0"
            },
            "sourceDigest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            },
            "reviewStatus": {
              "const": "proposed"
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  },
                  "supportingProjectIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "supportingSignalIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "observationIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pointer": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "sourceId",
                        "pointer"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "confidence": {
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "confirmationStatus": {
                    "const": "unconfirmed"
                  },
                  "alternativeInterpretations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "contradictions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "reviewQuestions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "type",
                  "label",
                  "meaning",
                  "supportingProjectIds",
                  "supportingSignalIds",
                  "observationIds",
                  "evidenceRefs",
                  "reasons",
                  "confidence",
                  "confirmationStatus",
                  "alternativeInterpretations",
                  "contradictions",
                  "reviewQuestions"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fromCandidateId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "toCandidateId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "related",
                      "distinct",
                      "alternative",
                      "broader",
                      "narrower"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "fromCandidateId",
                  "toCandidateId",
                  "type",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "episodeCandidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "projectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "occurrenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pointer": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "sourceId",
                        "pointer"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claimBasis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "outcomeStatus": {
                    "enum": [
                      "source-described",
                      "delivered",
                      "stopped",
                      "idea",
                      "mixed",
                      "unresolved"
                    ]
                  },
                  "independenceStatus": {
                    "enum": [
                      "unresolved",
                      "same-project",
                      "distinct-episode-proposed"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "projectId",
                  "occurrenceIds",
                  "evidenceRefs",
                  "summary",
                  "claimBasis",
                  "limitations",
                  "outcomeStatus",
                  "independenceStatus",
                  "rationale"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "reviewQuestions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "identityReviewGroups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "projectIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "disposition": {
                    "const": "review-only"
                  },
                  "independenceRelation": {
                    "enum": [
                      "unresolved",
                      "same-program",
                      "distinct-context-proposed"
                    ]
                  }
                },
                "required": [
                  "id",
                  "label",
                  "projectIds",
                  "reason",
                  "disposition",
                  "independenceRelation"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "classificationTypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "label",
                  "meaning",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "rejectedGroupings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "proposedCandidateIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "projectIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pointer": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "sourceId",
                        "pointer"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contradictions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "proposedCandidateIds",
                  "projectIds",
                  "evidenceRefs",
                  "reason",
                  "contradictions"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "synthesisNotes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "schemaVersion",
            "sourceDigest",
            "reviewStatus",
            "reviewer",
            "revision",
            "candidates",
            "relationships",
            "episodeCandidates",
            "reviewQuestions",
            "identityReviewGroups"
          ],
          "additionalProperties": false
        }
      ]
    },
    "identityReviewGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "const": "review-only"
          },
          "independenceRelation": {
            "enum": [
              "unresolved",
              "same-program",
              "distinct-context-proposed"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "projectIds",
          "reason",
          "disposition",
          "independenceRelation"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "rejectedGroupings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "proposedCandidateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "pointer"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "proposedCandidateIds",
          "projectIds",
          "evidenceRefs",
          "reason",
          "contradictions"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "synthesisNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "classificationTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "label",
          "meaning",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "exactObservationDuplicateGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonicalSha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceObservationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "disposition": {
            "const": "Retained all source observations; duplicates are not independent evidence."
          }
        },
        "required": [
          "canonicalSha256",
          "sourceObservationIds",
          "disposition"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "identityMergesPerformed": {
      "type": "array",
      "maxItems": 0,
      "items": {}
    },
    "independence": {
      "type": "object",
      "properties": {
        "observedContextCount": {
          "type": "integer",
          "minimum": 0
        },
        "conservativeIndependentContextCount": {
          "type": "integer",
          "minimum": 0
        },
        "independentContextBounds": {
          "type": "object",
          "properties": {
            "lower": {
              "type": "integer",
              "minimum": 0
            },
            "upper": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "lower",
            "upper"
          ],
          "additionalProperties": false
        },
        "confirmedIndependentEpisodeCount": {
          "const": 0
        },
        "demonstrationCount": {
          "const": 0
        },
        "contextGroups": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "minItems": 0
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "observedContextCount",
        "conservativeIndependentContextCount",
        "independentContextBounds",
        "confirmedIndependentEpisodeCount",
        "demonstrationCount",
        "contextGroups",
        "qualification"
      ],
      "additionalProperties": false
    },
    "ancillaryFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "retention": {
            "const": "metadata-only-non-interview"
          }
        },
        "required": [
          "relativePath",
          "byteLength",
          "sha256",
          "retention"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "inputInventoryDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "publicationDecision": {
      "const": "Withheld: Phase 2A is a private editorial foundation."
    },
    "reviewQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "sourceDigest",
    "publicationApproval",
    "storageMergeReport",
    "editorialReview",
    "identityReviewGroups",
    "rejectedGroupings",
    "synthesisNotes",
    "classificationTypes",
    "exactObservationDuplicateGroups",
    "identityMergesPerformed",
    "independence",
    "ancillaryFiles",
    "inputInventoryDigest",
    "publicationDecision",
    "reviewQuestions"
  ],
  "additionalProperties": false,
  "$id": "https://gomercin.github.io/mosaic/schemas/consolidation-decisions.v2a.schema.json",
  "title": "Private Phase 2A consolidation decisions"
}
