            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "supportingProjectIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "confidence": {
                "type": "string",
                "minLength": 1
              },
              "confirmedByUser": {
                "type": "boolean"
              }
            },
            "required": [
              "label",
              "interpretation",
              "supportingProjectIds",
              "confidence",
              "confirmedByUser"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0
    },
    "exportNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "profileContext",
    "projects",
    "crossProjectObservations",
    "suggestedClassificationTypes",
    "exportNotes"
  ],
  "additionalProperties": false
}
