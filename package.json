{
  "name": "mosaic-capability-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:designs": "vite --config vite.designs.config.ts",
    "dev:designs:private": "MOSAIC_DESIGN_PRIVATE=1 vite --config vite.designs.config.ts",
    "design:profile": "node scripts/build-design-profile.mjs",
    "build:designs": "tsc && vite build --config vite.designs.config.ts && node scripts/validate-design-build.mjs",
    "preview:designs": "vite preview --config vite.designs.config.ts --host 127.0.0.1 --port 5187 --strictPort",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-mosaic-data.mjs public/data/mosaic.json",
    "test": "npm run typecheck && npm run generate:data -- --check && npm run validate:data && node --test scripts/*.test.mjs",
    "build": "npm run generate:data -- --check && npm run validate:data && tsc && vite build && npm run validate:dist",
    "preview": "vite preview",
    "inventory:interviews": "node scripts/inventory-interviews.mjs",
    "generate:data": "node scripts/build-public-data.mjs",
    "validate:dist": "node scripts/validate-public-build.mjs",
    "browser:test": "npm run build && playwright test",
    "consolidate:interviews": "node scripts/consolidate-interviews.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
